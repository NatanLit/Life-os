# Copy to .env for local use, or set these as Environment Variables in Vercel.

# Access code — required to read/write your data once deployed to a public URL.
# Pick any private string. Leave unset locally to keep the app open on your machine.
ACCESS_CODE=change-me

# Redis (production storage) — Vercel's "Redis" Marketplace integration fills this in for
# you automatically once connected to the project. You normally don't set it by hand.
# REDIS_URL=

# Alternative: an Upstash-style REST API is also supported, if that's what you connected.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
