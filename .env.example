# Copy to .env for local use, or set these as Environment Variables in Vercel.

# Access code — required to read/write your data once deployed to a public URL.
# Pick any private string. Leave unset locally to keep the app open on your machine.
ACCESS_CODE=change-me

# Upstash Redis (production storage). The Vercel "Upstash for Redis" integration
# fills these in for you automatically — you normally don't set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
